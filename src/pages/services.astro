---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/site';

// Two-row dial labels keep the ring text clear of the stage copy.
const dialLines: Record<string, string> = {
  operations: 'Managed<br>Operations',
  process: 'Process<br>Design',
  infrastructure: 'On/Offchain<br>Infra',
  reporting: 'Reporting &amp;<br>Transparency',
  delivery: 'Program<br>Incubation',
};
---
<BaseLayout title="Services · Soter Labs" description="Explore Soter’s connected services across managed operations, process design, technical infrastructure, reporting, program delivery, and incubation." active="services">
  <header class="page-hero page-hero--apparatus"><div class="page-hero__inner"><p class="page-hero__kicker fade-in">Services</p><h1 class="page-hero__title fade-in">Built around the work, not a service menu.</h1><p class="page-hero__lede fade-in">Soter connects operations, methodology, infrastructure, and reporting around the outcome an organization needs. We can own a defined layer or build and run the complete system.</p></div></header>
  <section class="section section--flush signature-stage" id="console"><div class="section__inner"><div class="console fade-in">
    <div class="console__dial-wrap"><div class="dial" aria-hidden="true"><div class="dial__needle" id="dial-needle"></div><div class="dial__hub"><img src="/assets/images/logo_wo_name_transparent.png" alt="" /></div></div>
      {services.map((service, i) => <button type="button" class:list={['dial__label', { 'is-active': i === 0 }]} data-svc={service.id} style={`--a: ${service.angle}deg; --shift: ${i === 0 ? '0%' : i < 3 ? '50%' : '-50%'};`} set:html={dialLines[service.id] ?? service.name}></button>)}
    </div>
    <div class="console__stage" id="console-stage" aria-live="polite"><p class="console__eyebrow" id="stage-eyebrow">{services[0].tag}</p><h2 class="console__title" id="stage-title">{services[0].name}</h2><p class="console__lede" id="stage-lede">{services[0].lede}</p><ul class="check-list" id="stage-list">{services[0].items.map((item) => <li>{item}</li>)}</ul></div>
  </div></div></section>
  <section class="section" id="engagements"><div class="section__inner"><div class="section-intro section-intro--split fade-in"><div><p class="section__eyebrow">How engagements take shape</p><h2 class="section__label">Start with the outcome.</h2></div><div class="section-intro__body"><p>Some organizations need a defined capability: reporting, infrastructure, process design, or recurring operations. Others need the complete system.</p><p>Soter starts by understanding the intended outcome, the current operating environment, and the responsibilities already in place. From there, we define where Soter should own, support, build, or coordinate.</p><a href="/contact" class="section-link">Talk through an operation →</a></div></div></div></section>
  <script id="services-data" type="application/json" set:html={JSON.stringify(services)}></script>
  <script slot="scripts" is:inline>
    (function(){var el=document.getElementById('services-data');if(!el)return;var list=JSON.parse(el.textContent);var data={};list.forEach(function(s){data[s.id]=s;});var needle=document.getElementById('dial-needle');var labels=document.querySelectorAll('.dial__label');var current='operations';var deg=0;function select(id){var d=data[id];if(!d)return;var target=d.angle%360;var now=((deg%360)+360)%360;var delta=target-now;if(delta>180)delta-=360;if(delta<-180)delta+=360;deg+=delta;needle.style.transform='rotate('+deg+'deg)';labels.forEach(function(b){b.classList.toggle('is-active',b.dataset.svc===id);});document.getElementById('stage-eyebrow').textContent=d.tag;document.getElementById('stage-title').textContent=d.name;document.getElementById('stage-lede').textContent=d.lede;document.getElementById('stage-list').innerHTML=d.items.map(function(x){return '<li>'+x+'</li>';}).join('');current=id;history.replaceState(null,'','#'+id);}labels.forEach(function(b){b.addEventListener('click',function(){if(b.dataset.svc!==current)select(b.dataset.svc);});});var requested=location.hash.slice(1);if(data[requested])select(requested);})();
  </script>
</BaseLayout>
