---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Soter at work across Sky · Soter Labs" description="Explore Soter’s work across the Sky Ecosystem, including direct mandates, Operational Executor Agents, serviced agents, infrastructure, incubation, and reporting." active="clients">
  <header class="page-hero page-hero--apparatus page-hero--nogrid">
    <div class="page-hero__inner">
      <p class="page-hero__kicker fade-in">Work · Sky Ecosystem</p>
      <h1 class="page-hero__title fade-in">Delivering Decentralized Operations</h1>
      <p class="page-hero__lede fade-in">The Sky Ecosystem is the most complete example of Soter’s work today, delivering services to one of the most complex organizations in onchain finance.</p>
    </div>
  </header>

  <section class="section section--flush signature-stage signature-stage--nogrid" id="proof">
    <div class="section__inner">
      <div class="orrery fade-in" id="orrery">
        <div class="orrery__glow" aria-hidden="true"></div>
        <div class="orrery__path" id="path-sff" aria-hidden="true"></div>
        <div class="orrery__path" id="path-sat-console" aria-hidden="true"></div>
        <div class="orrery__path" id="path-sat-osero" aria-hidden="true"></div>
        <div class="orrery__path" id="path-sat-grove" aria-hidden="true"></div>
        <div class="orrery__path" id="path-ozone" aria-hidden="true"></div>
        <div class="orrery__path" id="path-amatsu" aria-hidden="true"></div>
        <div class="orrery__moonpath" id="moonpath-ozone" aria-hidden="true"></div>
        <div class="orrery__moonpath" id="moonpath-amatsu" aria-hidden="true"></div>

        <a class="orrery__sun" data-client="sky" href="https://www.skyeco.com/" target="_blank" rel="noopener" aria-label="Sky Ecosystem">
          <span class="orrery__sun-core"><img src="/assets/images/sky.svg" alt="Sky Ecosystem"></span>
          <span class="orrery__caption">Sky Ecosystem</span>
        </a>

        <div class="orrery__body orrery__body--sat" id="sat-console" data-client="sky" tabindex="0" role="button" aria-label="Settlement reporting, delivered for the Sky Ecosystem">
          <span class="orrery__face orrery__face--sat"></span>
          <span class="orrery__caption orrery__caption--hover">Settlement reporting</span>
        </div>

        <div class="orrery__body orrery__body--sat" id="sat-osero" data-client="osero" tabindex="0" role="button" aria-label="Osero incubation, delivered with Stablewatch">
          <span class="orrery__face orrery__face--sat orrery__face--sat-sm"></span>
          <span class="orrery__caption orrery__caption--hover">Incubation</span>
        </div>

        <div class="orrery__body orrery__body--sat" id="sat-grove" data-client="grove" tabindex="0" role="button" aria-label="TGE launch tracker, delivered for Grove">
          <span class="orrery__face orrery__face--sat orrery__face--sat-sm"></span>
          <span class="orrery__caption orrery__caption--hover">TGE launch tracker</span>
        </div>

        <a class="orrery__body" id="node-sff" data-client="sff" href="https://insights.skyeco.com/" target="_blank" rel="noopener" aria-label="Sky Frontier Foundation">
          <span class="orrery__face orrery__face--initials">SFF</span>
          <span class="orrery__caption orrery__caption--hover">Sky Frontier Foundation</span>
        </a>

        <div class="orrery__body" id="node-ccea" data-client="ccea" tabindex="0" role="button" aria-label="Core Council Executor Agent">
          <span class="orrery__face orrery__face--initials">CC</span>
          <span class="orrery__caption orrery__caption--hover">Core Council Executor Agent</span>
        </div>

        <div class="orrery__body" id="planet-ozone" data-client="ozone" tabindex="0" role="button" aria-label="Ozone OEA">
          <span class="orrery__face orrery__face--planet">O</span>
          <span class="orrery__caption">Ozone OEA</span>
        </div>

        <div class="orrery__body" id="planet-amatsu" data-client="amatsu" tabindex="0" role="button" aria-label="Amatsu OEA">
          <span class="orrery__face orrery__face--planet">A</span>
          <span class="orrery__caption">Amatsu OEA</span>
        </div>

      <a class="orrery__body orrery__body--moon" data-sys="ozone" data-i="0" data-client="obex" href="https://obex.xyz/" target="_blank" rel="noopener">
        <span class="orrery__face orrery__face--img"><img src="/assets/images/obex.jpg" alt="Obex"></span>
        <span class="orrery__caption orrery__caption--hover">Obex</span>
      </a>
      <a class="orrery__body orrery__body--moon" data-sys="ozone" data-i="1" data-client="skybase" href="https://sky.money/" target="_blank" rel="noopener">
        <span class="orrery__face orrery__face--img orrery__face--wordmark"><img src="/assets/images/sky.svg" alt="Skybase"></span>
        <span class="orrery__caption orrery__caption--hover">Skybase</span>
      </a>
      <div class="orrery__body orrery__body--moon orrery__body--pending" data-sys="ozone" data-i="2" data-client="pattern" tabindex="0" role="button">
        <span class="orrery__face orrery__face--img">P</span>
        <span class="orrery__caption orrery__caption--hover">Pattern &middot; onboarding</span>
      </div>
      <a class="orrery__body orrery__body--moon" data-sys="ozone" data-i="3" data-client="osero" href="https://osero.org/" target="_blank" rel="noopener">
        <span class="orrery__face orrery__face--img"><img src="/assets/images/osero.jpg" alt="Osero"></span>
        <span class="orrery__caption orrery__caption--hover">Osero</span>
      </a>
      <div class="orrery__body orrery__body--moon orrery__body--pending" data-sys="ozone" data-i="4" data-client="la7" tabindex="0" role="button">
        <span class="orrery__face orrery__face--img">L</span>
        <span class="orrery__caption orrery__caption--hover">Launch Agent 7 &middot; onboarding</span>
      </div>
      <a class="orrery__body orrery__body--moon" data-sys="amatsu" data-i="0" data-client="spark" href="https://spark.fi" target="_blank" rel="noopener">
        <span class="orrery__face orrery__face--img orrery__face--wordmark"><img src="/assets/images/spark.svg" alt="Spark"></span>
        <span class="orrery__caption orrery__caption--hover">Spark</span>
      </a>
      <a class="orrery__body orrery__body--moon" data-sys="amatsu" data-i="1" data-client="grove" href="https://www.grove.finance/" target="_blank" rel="noopener">
        <span class="orrery__face orrery__face--img"><img src="/assets/images/grove.jpg" alt="Grove"></span>
        <span class="orrery__caption orrery__caption--hover">Grove</span>
      </a>
      <a class="orrery__body orrery__body--moon" data-sys="amatsu" data-i="2" data-client="keel" href="https://keel.fi/" target="_blank" rel="noopener">
        <span class="orrery__face orrery__face--img"><img src="/assets/images/keel.png" alt="Keel"></span>
        <span class="orrery__caption orrery__caption--hover">Keel</span>
      </a>
      </div>

      <div class="client-index fade-in" id="client-index">
        <div class="client-index__cards">
    <article class="client-card is-active" id="card-sky">
      <p class="client-card__kicker">Ecosystem &middot; direct mandate</p>
      <h3 class="client-card__name">Sky Ecosystem</h3>
      <p class="client-card__desc">The Sky Ecosystem is Soter’s most complete operating environment. Soter supports ecosystem-level mandates directly and drives execution through two Operational Executor Agents, connecting governance, operations, technical delivery, settlement, and reporting across the agents they serve.</p>
      <div class="client-card__links">
        <a href="https://www.skyeco.com/" target="_blank" rel="noopener" class="section-link">www.skyeco.com &rarr;</a>
        <a href="https://x.com/SkyEcosystem" target="_blank" rel="noopener" class="section-link">@SkyEcosystem &rarr;</a>
      </div>
      <div class="client-card__delivered">
        <div class="client-card__delivered-heading"><span><span class="system__pulse" aria-hidden="true"></span>Delivered</span></div>
        <div class="delivered-list" role="list">
          <a class="delivered-item" role="listitem" href="https://settle.soterlabs.com" target="_blank" rel="noopener">
            <span class="delivered-item__name">Settlement reporting</span>
            <span class="delivered-item__desc">Live settlement-cycle and distribution reporting</span>
            <span class="delivered-item__action">Open dashboard <span aria-hidden="true">&nearr;</span></span>
          </a>
        </div>
      </div>
    </article>
    <article class="client-card" id="card-sff">
      <p class="client-card__kicker">Ecosystem &middot; direct mandate</p>
      <h3 class="client-card__name">Sky Frontier Foundation</h3>
      <p class="client-card__desc">The independent foundation supporting innovation, development, research, and ecosystem growth across Sky. Soter provides operational and program support across selected foundation initiatives.</p>
      <div class="client-card__links">
        <a href="https://insights.skyeco.com/" target="_blank" rel="noopener" class="section-link">insights.skyeco.com &rarr;</a>
      </div>
    </article>
    <article class="client-card" id="card-ccea">
      <p class="client-card__kicker">Operational Executor Agent</p>
      <h3 class="client-card__name">Core Council Executor Agent</h3>
      <p class="client-card__desc">An Operational Executor Agent in the Sky Ecosystem. Soter drives its recurring operational cycle, including governance execution, coordination, and reporting.</p>
    </article>
    <article class="client-card" id="card-ozone">
      <p class="client-card__kicker">Operational Executor Agent &middot; driven by Soter</p>
      <h3 class="client-card__name">Ozone OEA</h3>
      <p class="client-card__desc">Soter drives Ozone end to end: recurring spell cycles, deployment coordination, Atlas alignment, operational follow-through, and transparent reporting for the five agents it services.</p>
    </article>
    <article class="client-card" id="card-amatsu">
      <p class="client-card__kicker">Operational Executor Agent &middot; driven by Soter</p>
      <h3 class="client-card__name">Amatsu OEA</h3>
      <p class="client-card__desc">Soter drives Amatsu’s recurring operational cycle, including governance execution and the monthly settlement calculations and reporting required under the Atlas.</p>
    </article>
    <article class="client-card" id="card-obex">
      <p class="client-card__kicker">Agent &middot; serviced via Ozone OEA</p>
      <h3 class="client-card__name">Obex</h3>
      <p class="client-card__desc">An incubator agent supporting new projects entering the Sky Ecosystem. Soter provides operational coverage through the Ozone OEA cycle.</p>
      <div class="client-card__links">
        <a href="https://obex.xyz/" target="_blank" rel="noopener" class="section-link">obex.xyz &rarr;</a>
        <a href="https://x.com/obexincubator" target="_blank" rel="noopener" class="section-link">@obexincubator &rarr;</a>
      </div>
    </article>
    <article class="client-card" id="card-skybase">
      <p class="client-card__kicker">Agent &middot; serviced via Ozone OEA</p>
      <h3 class="client-card__name">Skybase</h3>
      <p class="client-card__desc">An agent in the Sky network, supported through Ozone’s recurring governance, monitoring, and reporting cycle.</p>
      <div class="client-card__links">
        <a href="https://sky.money/" target="_blank" rel="noopener" class="section-link">sky.money &rarr;</a>
        <a href="https://x.com/SkyMoney" target="_blank" rel="noopener" class="section-link">@SkyMoney &rarr;</a>
      </div>
    </article>
    <article class="client-card" id="card-pattern">
      <p class="client-card__kicker">Agent &middot; onboarding through Ozone</p>
      <h3 class="client-card__name">Pattern</h3>
      <p class="client-card__desc">An emerging Sky agent preparing for launch. Soter’s operational coverage begins through the Ozone OEA.</p>
    </article>
    <article class="client-card" id="card-osero">
      <p class="client-card__kicker">Agent &middot; serviced via Ozone OEA</p>
      <h3 class="client-card__name">Osero</h3>
      <p class="client-card__desc">Stablecoin savings infrastructure built around Sky’s USDS and sUSDS. Osero was incubated by Stablewatch in partnership with Soter Labs and is serviced through the Ozone OEA cycle.</p>
      <div class="client-card__links">
        <a href="https://osero.org/" target="_blank" rel="noopener" class="section-link">osero.org &rarr;</a>
        <a href="https://x.com/OseroHQ" target="_blank" rel="noopener" class="section-link">@OseroHQ &rarr;</a>
      </div>
      <div class="client-card__delivered">
        <div class="client-card__delivered-heading"><span><span class="system__pulse" aria-hidden="true"></span>Delivered</span></div>
        <div class="delivered-list" role="list">
          <a class="delivered-item" role="listitem" href="https://www.theblock.co/post/400948/sky-ecosystem-stablewatch-stablecoin-yield-startup-osero-funding" target="_blank" rel="noopener">
            <span class="delivered-item__name">Agent incubation</span>
            <span class="delivered-item__desc">Incubated with Stablewatch &middot; reported by The Block</span>
            <span class="delivered-item__action">Read coverage <span aria-hidden="true">&nearr;</span></span>
          </a>
        </div>
      </div>
    </article>
    <article class="client-card" id="card-la7">
      <p class="client-card__kicker">Agent &middot; onboarding through Ozone</p>
      <h3 class="client-card__name">Launch Agent 7</h3>
      <p class="client-card__desc">An emerging Sky agent preparing for launch. Soter’s operational coverage begins through the Ozone OEA.</p>
    </article>
    <article class="client-card" id="card-spark">
      <p class="client-card__kicker">Agent &middot; serviced via Amatsu OEA</p>
      <h3 class="client-card__name">Spark</h3>
      <p class="client-card__desc">A DeFi capital allocator in the Sky Ecosystem, serviced through Amatsu’s recurring governance, settlement, and reporting cycle.</p>
      <div class="client-card__links">
        <a href="https://spark.fi" target="_blank" rel="noopener" class="section-link">spark.fi &rarr;</a>
        <a href="https://x.com/sparkdotfi" target="_blank" rel="noopener" class="section-link">@sparkdotfi &rarr;</a>
      </div>
    </article>
    <article class="client-card" id="card-grove">
      <p class="client-card__kicker">Agent &middot; serviced via Amatsu OEA</p>
      <h3 class="client-card__name">Grove</h3>
      <p class="client-card__desc">An agent focused on deploying capital into tokenized onchain investment vehicles, serviced through the Amatsu operating cycle.</p>
      <div class="client-card__links">
        <a href="https://www.grove.finance/" target="_blank" rel="noopener" class="section-link">www.grove.finance &rarr;</a>
        <a href="https://x.com/grovedotfinance" target="_blank" rel="noopener" class="section-link">@grovedotfinance &rarr;</a>
      </div>
      <div class="client-card__delivered">
        <div class="client-card__delivered-heading"><span><span class="system__pulse" aria-hidden="true"></span>Delivered</span></div>
        <div class="delivered-list" role="list">
          <a class="delivered-item" role="listitem" href="https://skywolf303.github.io/grove-tge-dashboard/#analytics" target="_blank" rel="noopener">
            <span class="delivered-item__name">TGE launch tracker</span>
            <span class="delivered-item__desc">Grove TGE launch tracking and analytics</span>
            <span class="delivered-item__action">Open tracker <span aria-hidden="true">&nearr;</span></span>
          </a>
        </div>
      </div>
    </article>
    <article class="client-card" id="card-keel">
      <p class="client-card__kicker">Agent &middot; serviced via Amatsu OEA</p>
      <h3 class="client-card__name">Keel</h3>
      <p class="client-card__desc">An agent allocating capital into Solana-based real-world assets through its Regatta program, serviced through the Amatsu operating cycle.</p>
      <div class="client-card__links">
        <a href="https://keel.fi/" target="_blank" rel="noopener" class="section-link">keel.fi &rarr;</a>
        <a href="https://x.com/keel_fi" target="_blank" rel="noopener" class="section-link">@keel_fi &rarr;</a>
      </div>
    </article>
        </div>
        <nav class="client-index__list" aria-label="Client index">
      <p class="client-index__group">Ecosystem</p>
      <button type="button" class="client-index__item" data-client="sky">Sky Ecosystem</button>
      <button type="button" class="client-index__item" data-client="sff">Sky Frontier Foundation</button>
      <p class="client-index__group">Executors</p>
      <button type="button" class="client-index__item" data-client="ccea">Core Council Executor Agent</button>
      <button type="button" class="client-index__item" data-client="ozone">Ozone OEA</button>
      <button type="button" class="client-index__item" data-client="amatsu">Amatsu OEA</button>
      <p class="client-index__group">Serviced via Ozone</p>
      <button type="button" class="client-index__item" data-client="obex">Obex</button>
      <button type="button" class="client-index__item" data-client="skybase">Skybase</button>
      <button type="button" class="client-index__item" data-client="pattern">Pattern</button>
      <button type="button" class="client-index__item" data-client="osero">Osero</button>
      <button type="button" class="client-index__item" data-client="la7">Launch Agent 7</button>
      <p class="client-index__group">Serviced via Amatsu</p>
      <button type="button" class="client-index__item" data-client="spark">Spark</button>
      <button type="button" class="client-index__item" data-client="grove">Grove</button>
      <button type="button" class="client-index__item" data-client="keel">Keel</button>
        </nav>
      </div>
    </div>
  </section>


  <script slot="scripts" is:inline src="/assets/js/clients-orrery.js"></script>
</BaseLayout>
