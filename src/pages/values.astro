---
import BaseLayout from '../layouts/BaseLayout.astro';
import { values } from '../data/site';
---
<BaseLayout title="How Soter works · Soter Labs" description="The observable standards behind Soter’s work: simplicity, transparency, accountability, and reliability." active="values">
  <header class="page-hero page-hero--apparatus"><div class="page-hero__inner"><p class="page-hero__kicker fade-in">How we work</p><h1 class="page-hero__title fade-in">Values you can see in the work.</h1><p class="page-hero__lede fade-in">A value matters when it changes how the work is performed. These standards show up in Soter’s ownership, operating cadence, decisions, reporting, and handoffs.</p></div></header>
  <section class="section section--flush signature-stage signature-stage--sticky-record"><div class="section__inner"><div class="vspy">
    <nav class="vspy__rail" aria-label="Values"><span class="vspy__indicator" id="vspy-indicator" aria-hidden="true"></span>{values.map((value, i) => <button type="button" class:list={['vspy__word', { 'is-active': i === 0 }]} data-target={value.id}>{value.name}</button>)}</nav>
    <div class="vspy__content">{values.map((value, i) => <div class="vspy__block" id={value.id} style={`--value-index: ${i}`}><div class="vspy__block-inner"><p class="section__eyebrow">Observable standard</p><h2 class="vspy__blockword">{value.name}</h2><p class="vspy__line">{value.line}</p><ul class="receipts">{value.receipts.map((receipt) => <li>{receipt}</li>)}</ul></div></div>)}</div>
  </div></div></section>
  <script slot="scripts" is:inline>
    (function(){var words=[].slice.call(document.querySelectorAll('.vspy__word'));var blocks=[].slice.call(document.querySelectorAll('.vspy__block'));var indicator=document.getElementById('vspy-indicator');if(!words.length||!blocks.length||!indicator)return;document.documentElement.classList.add('values-page');var current='';function active(id){if(id===current)return;current=id;var activeIndex=0;words.forEach(function(w,i){var on=w.dataset.target===id;w.classList.toggle('is-active',on);if(on)activeIndex=i;});blocks.forEach(function(b,i){b.classList.toggle('is-active',b.id===id);b.classList.toggle('is-past',i<activeIndex);});var hit=words[activeIndex];indicator.style.top=(hit.offsetTop+hit.offsetHeight/2-15)+'px';}function sync(){var line=(parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h'))||64)+96;var closest=blocks[0];var distance=Infinity;blocks.forEach(function(b){var d=Math.abs(b.getBoundingClientRect().top-line);if(d<distance){distance=d;closest=b;}});active(closest.id);}var ticking=false;function requestSync(){if(ticking)return;ticking=true;requestAnimationFrame(function(){sync();ticking=false;});}words.forEach(function(w){w.addEventListener('click',function(){document.getElementById(w.dataset.target).scrollIntoView({behavior:'smooth',block:'start'});});});window.addEventListener('scroll',requestSync,{passive:true});window.addEventListener('resize',requestSync);active(words[0].dataset.target);requestSync();})();
  </script>
</BaseLayout>
